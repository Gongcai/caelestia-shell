+GLuint buildContour(SP<Render::IFramebuffer> surface, std::array<SP<Render::IFramebuffer>, 2>& buffers,
+                    SP<Render::IFramebuffer> target, float threshold) {
+    const int width = std::max(1, static_cast<int>(surface->m_size.x) / 2);
+    const int height = std::max(1, static_cast<int>(surface->m_size.y) / 2);
+    for (auto& fb : buffers) {
+        if (!fb)
+            fb = g_pHyprRenderer->createFB("hyprglass-contour");
+        if (fb->m_size.x != width || fb->m_size.y != height)
+            fb->alloc(width, height, DRM_FORMAT_ABGR16161616F);
+    }
+    static constexpr std::array<float, 9> projection = {2, 0, 0, 0, 2, 0, -1, -1, 1};
+    auto& manager = g_pGlobalState->shaderManager;
+    auto shader = g_pHyprOpenGL->useShader(manager.contourShader);
+    shader->setUniformMatrix3fv(SHADER_PROJ, 1, GL_FALSE, projection);
+    shader->setUniformInt(SHADER_TEX, 0);
+    glUniform1f(manager.contourThreshold, threshold);
+    glBindVertexArray(shader->getUniformLocation(SHADER_SHADER_VAO));
+    g_pHyprOpenGL->setCapStatus(GL_SCISSOR_TEST, false);
+    const bool blend = glIsEnabled(GL_BLEND);
+    g_pHyprOpenGL->setCapStatus(GL_BLEND, false);
+    g_pHyprOpenGL->setViewport(0, 0, width, height);
+    glActiveTexture(GL_TEXTURE0);
+    int output = 0;
+    // 64 physical pixels is enough for the edge refraction band. Work is
+    // bounded independently of the output resolution; no CPU readback.
+    for (int step : {0, 16, 8, 4, 2, 1, 1}) {
+        glBindFramebuffer(GL_FRAMEBUFFER, fbId(buffers[output]));
+        (step == 0 ? surface : buffers[1 - output])->getTexture()->bind();
+        glUniform1i(manager.contourStep, step);
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        output = 1 - output;
+    }
+    g_pHyprOpenGL->setCapStatus(GL_BLEND, blend);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbId(target));
+    g_pHyprOpenGL->setViewport(0, 0, target->m_size.x, target->m_size.y);
+    glBindVertexArray(0);
+    return buffers[1 - output]->getTexture()->m_texID;
+}
