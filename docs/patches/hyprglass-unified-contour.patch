+    if (const auto it = g_pGlobalState->layerNamespaceMaterialBlurIterations.find(layerSurface->m_namespace);
+        it != g_pGlobalState->layerNamespaceMaterialBlurIterations.end())
+        material.iterations = std::clamp(it->second, 1, 5);
+    if (const auto it = g_pGlobalState->layerNamespaceMaterialAlphaThreshold.find(layerSurface->m_namespace);
+        it != g_pGlobalState->layerNamespaceMaterialAlphaThreshold.end())
+        material.alphaThreshold = std::clamp(it->second, 0.0f, 1.0f);
+
+    return material;
+}
